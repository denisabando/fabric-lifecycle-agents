{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "fabric-lifecycle-agents",
  "description": "Consulting agents for Microsoft Fabric engagement work \u2014 semantic models and reports today, more domains later. Each domain layers firm standards and per-client overrides on top of Microsoft's vendored skills.",
  "version": "0.7.0",
  "license": "Proprietary",
  "keywords": [
    "fabric",
    "powerbi",
    "semantic-model",
    "tmdl",
    "dax",
    "consulting"
  ],
  "skills": [
    "./skills/semantic-model",
    "./skills/report",
    "./skills/<domain>/SKILL.md",
    "./skills/engagement-workflow",
    "./vendor/skills-for-fabric/plugins/powerbi-authoring/skills/semantic-model-authoring",
    "./vendor/skills-for-fabric/plugins/powerbi-authoring/skills/powerbi-report-planning",
    "./vendor/skills-for-fabric/plugins/powerbi-authoring/skills/powerbi-report-design",
    "./vendor/skills-for-fabric/plugins/powerbi-authoring/skills/powerbi-report-authoring",
    "./vendor/skills-for-fabric/plugins/powerbi-authoring/skills/powerbi-report-management"
  ],
  "agents": [
    "./agents/modeler.md",
    "./agents/reviewer.md",
    "./agents/deployer.md",
    "./agents/report-reviewer.md"
  ],
  "commands": [
    "./commands/new-engagement.md",
    "./commands/review.md",
    "./commands/sync-upstream.md"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "powerbi-modeling-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/powerbi-modeling-mcp@latest",
        "--start"
      ]
    }
  }
}
