/// Sales fact — one row per receipt line. No measures here (MOD-03), no calculated columns (Microsoft dax-guidelines).
table Sales
	isHidden

	annotation table_type = fact

	column DateKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: DateKey

	column StoreKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: StoreKey

	column ProductKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ProductKey

	column ReceiptId
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ReceiptId

	column NetAmount
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: NetAmount

	column Quantity
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Quantity

	partition Sales = m
		mode: import
		source =
			let
				Source = Lakehouse.Contents(null){[workspaceId = "<dev-workspace-id>"]}[Data]{[lakehouseId = "<lakehouse-id>"]}[Data],
				T = Source{[Id = "fact_sales_line", ItemKind = "Table"]}[Data]
			in
				T
